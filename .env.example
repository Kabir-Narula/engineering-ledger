# --- Contact form email delivery (Resend) -----------------------------------
# 1. Create a free key at https://resend.com (sign up with Kabirnar10@gmail.com)
# 2. Paste it below — the form switches from mock to real delivery automatically.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Inbox that receives contact-form messages
CONTACT_TO_EMAIL=Kabirnar10@gmail.com

# Sender identity. resend.dev works instantly with no domain setup;
# after verifying your own domain in Resend you can use e.g. hello@yourdomain.com
CONTACT_FROM_EMAIL=portfolio@resend.dev
